    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/420> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400> ;
        skos:definition """'Abbauflächen', 'Halden' und 'Deponien' sind Flächen, die zur oberirdischen Gewinnung von Rohstoffen (z.B. Sandgrube, Lehmgrube, Schottergrube, Steinbruch, Torfstich) oder zur dauerhaften Ablagerung von Altstoffen dienen (Definition: BEV Nutzungsarten).
Im ÖROK-Monitoring werden diese Flächen einerseits durch die Gebietsnutzung des digitalen Landschaftsmodells (Kategorie 3411 Abbau-Aufbereitugnsflächen) sowie durch die Kategorie 7 'Abbauflächen' der aggregierten Flächenwidmung gebildet."""@de,
            """'Mining areas', 'dumps' and 'landfills' are areas used for the above-ground extraction of raw materials (e.g. sand pit, clay pit, gravel pit, quarry, peat cut) or for the permanent deposition of waste materials (definition: Bev types of use).
In ÖROK monitoring, these areas are formed on the one hand by the area utilization of the digital landscape model (category 3411 mining processing areas) and by category 7 'mining areas' of the aggregated land use."""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/422>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/424>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/425> ;
        skos:notation "420" ;
        skos:prefLabel "Abbaufläche (Modul 42)"@de,
            "Mining area (module 42)"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/640> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/600> ;
        skos:definition "Andere Freiflächen, die nicht vorrangig Landwirtschaft oder Wald sind"@de,
            "Other open spaces that are not primarily agriculture or forest"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/641>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/642>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/643> ;
        skos:notation "640" ;
        skos:prefLabel "Freifläche-Sonstige"@de,
            "Open space-other"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/600> a skos:Concept ;
        skos:definition "Freiflächen, die nicht zur Flächeninanspruchnahme zählen"@de,
            "Open spaces that do not count as land use"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/610>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/620>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/630>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/640> ;
        skos:notation "600" ;
        skos:prefLabel "Freiflächen (Modul 60)"@de,
            "Open spaces (module 60)"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> a skos:Concept ;
        skos:definition "Verkehrsflächen umfassen alle Straßen, befestigte befahrbare Wege (z.B. landwirtschaftliche Güterwege) mit Ausnahme der Forst- und Almstraßen, Schienen sowie die funktional zugehörigen Flächen für den ruhenden Verkehr (z.B. Parkplätze, Bahnanlagen)."@de,
            "Transport areas comprise all roads, paved drivable tracks (e.g. agricultural service roads) with the exception of forest and alpine roads, railways, as well as functionally associated areas for stationary traffic (e.g. parking facilities, railway installations)."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/101>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/102>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/103>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/104>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/105> ;
        skos:notation "100" ;
        skos:prefLabel "Verkehr"@de,
            "transport"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220> a skos:Concept ;
        skos:definition """Die Siedlungsflächen außerhalb des gewidmeten Baulandes umfassen Gebäude außerhalb der Baulandwidmung und ihre funktional zugehörigen Flächen (Gebäudenebenflächen, direkt angrenzende Gärten, DKM-Betriebsflächen, Pufferflächen), wie zum Beispiel Häuser oder Streusiedlungen im Grünland, Bauernhöfe und weitere landwirtschaftliche Gebäude mit ihren Nebenflächen.
In dieser Klasse werden alle Gebäude erfasst, die weder im Verkehrsmodul noch in einer der aggregierten Flächenwidmungsklassen liegen. Die funktional zugeordneten Gärten werden mittels der DKM-Nutzungsart 'Hausgärten' erfasst, die entweder am gleichen Grundstück liegen oder auf benachbarten Grundstücken mit der gleichen Einlagezahl. Auch Betriebsflächen oder Gebäudenebenflächen werden gleichermaßen zugeordnet. Sofern keine direkt angrenzenden funktionalen Flächen in der DKM vorhanden sind, werden alle Flächen bis zu 11m rund um die Gebäude als zugehörige Flächen mitberechnet."""@de,
            """The settlement areas outside the dedicated building land include buildings outside the building land use and their functionally associated areas (building contiguous areas, directly adjacent gardens, DKM operating areas, buffer areas), such as houses or scattered settlements in grassland, farms and other agricultural buildings with their ancillary areas.
In this class, all buildings are recorded that are neither in the traffic module nor in one of the aggregated zoning classes."""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/221>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/222>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/223>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/224>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/225> ;
        skos:notation "220" ;
        skos:prefLabel "Siedlungsfläche außerhalb Baulandwidmung (Modul 22)"@de,
            "Settlement area outside building land (module 22)"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400> a skos:Concept ;
        skos:definition """Ver- und Entsorgungs- und Abbauflächen bestehen aus Betriebsflächen von Ver- und Entsorgungsinfrastruktur, wie Kläranlagen, Umspannwerken, Kraftwerken, Strommasten sowie Deponien und Abbauflächen, soweit sie nicht in den Siedlungsflächen miterfasst sind.
Alle landwirtschaftlichen Flächen, Waldflächen und Gewässer werden – wie auch in allen anderen Klassen – von der Flächeninanspruchnahme ausgenommen."""@de,
            """Supply and disposal and mining areas consist of operating areas of supply and disposal infrastructure, such as sewage treatment plants, substations, power plants, power poles, as well as landfills and mining areas, insofar as they are not included in the settlement areas.
As in all other classes, all agricultural land, forest land and water are excluded from land use."""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/410>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/420>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/495>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/496>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/497> ;
        skos:notation "400" ;
        skos:prefLabel "Ver-, Entsorgungs- und Abbauflächen (Modul 40)"@de,
            "Supply, disposal and mining areas (module 40)"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/410> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400> ;
        skos:definition """Unter die Ver- und Entsorgungsflächen fallen private und öffentliche Infrastrukturen zur Versorgung mit Strom (Kraftwerke, Umspannwerke), Wasser, Energie (Raffinerie, Strommasten) sowie Infrastrukturen der Entsorgung wie Kläranlagen, Müllverbrennungsanlagen u. ä. 
Der Staubereich von Lauf- oder Speicherkraftwerken wird nicht zur Flächeninanspruchnahme gezählt, da diese Flächen im Gewässerlayer enthalten sind."""@de,
            """The supply and disposal areas include private and public infrastructures for the supply of electricity (power plants, substations), water, energy (refinery, power poles) as well as disposal infrastructures such as sewage treatment plants, waste incineration plants, etc. 
The congestion area of run-of-river or storage power plants is not included in the area requirement, as these areas are contained in the body of water."""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/411>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/412>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/413>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/414>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/415> ;
        skos:notation "410" ;
        skos:prefLabel "Ver- und Entsorgung (Modul 41)"@de,
            "Supply and disposal (module 41)"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> a skos:Concept ;
        skos:definition """Diese 	Siedlungsflächen innerhalb des gewidmeten Baulandes bestehen aus bebauten, teilweise bebauten sowie unbebauten Grundstücken im gewidmeten Bauland, sofern diese nicht aktiv landwirtschaftlich genutzt oder bewaldet sind. Es erfolgt eine Untergliederung der Inanspruchnahme nach drei Hauptnutzungen anhand der aggregierten Flächenwidmungskategorien (Wohnnutzung, betriebliche Nutzung, sonstige bauliche Nutzungen).
Verkehrsflächen werden im Verkehrsmodul berücksichtigt, sofern Verkehrsflächen im Verkehrsmodul erfasst sind, werden sie einheitlich vom Modul 'Siedlungsfläche' ausgenommen. Die Verkehrswege der inneren Erschließung oder größere Parkflächen für den ruhenden Verkehr können je nach Bundesland noch sehr unterschiedlich in der Flächenwidmung erfasst sein. Daher ist eine standardisierte Erfassung als Verkehrsfläche im Rahmen des österreichweiten Monitorings erforderlich."""@de,
            "These settlement areas within the designated building land consist of developed, partially developed, and undeveloped parcels of land within the designated building land, provided that they are not actively used for agricultural purposes or forested. Land use is subdivided into three main categories based on the aggregated land-use designation categories (residential use, commercial use, other built-up uses). Transportation areas are accounted for in the transportation module. If transportation areas are recorded in the transportation module, they are uniformly excluded from the “Settlement Area” module. Internal access roads or larger parking areas for stationary traffic may still be recorded very differently in land-use designations depending on the federal state. Therefore, standardized recording as transportation areas is necessary within the framework of Austria-wide monitoring."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/211>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/212>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/213>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/214>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/215>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/216>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/217> ;
        skos:notation "210" ;
        skos:prefLabel "Siedlungsfläche innerhalb Baulandwidmung (Modul 21)"@de,
            "Siedlungsfläche innerhalb Baulandwidmung (Modul 21)"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/300> a skos:Concept ;
        skos:definition """Das Module 30 enthält sämtliche Freizeit- und Erholungsflächen, die sich außerhalb der Baulandwidmung befinden, wie Golfplätze, Bäder, Sportplätze, Stadien, Campingplätze, Parkanlagen, Tierparks oder Friedhöfe. 
Skipisten werden hier nicht erfasst, da sie Großteils auch landwirtschaftlich genutzt werden. Alle landwirtschaftlichen Flächen, Waldflächen und Gewässer werden – wie auch in allen anderen Klassen – von der Flächeninanspruchnahme ausgenommen. Als Beispiel dient der Wiener Prater, der prinzipiell als Erholungsfläche zur Verfügung steht, aber die geschlossenen Waldflächen zählen nicht zur Flächeninanspruchnahme, da sie dem Forstgesetz unterliegen und somit der Landnutzung 'Wald' zuzurechnen sind."""@de,
            """Module 30 contains all recreational and recreational areas that are located outside the building site, such as golf courses, baths, sports fields, stadiums, campsites, parks, animal parks or cemeteries. 
Ski slopes are not included here, as they are also largely used for agricultural purposes. As in all other classes, all agricultural land, forest land and water are excluded from land use. An example is the Viennese Prater, which"""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:narrower <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/301>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/302>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/303>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/311>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/395>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/396>,
            <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/397> ;
        skos:notation "300" ;
        skos:prefLabel "Freizeit und Erholung (Modul 30)"@de,
            "Leisure and Recreation (Module 30)"@en ;
        skos:topConceptOf <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

