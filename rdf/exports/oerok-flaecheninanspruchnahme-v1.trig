    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/301> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/300> ;
        skos:definition "keine Auswertungskategorie, nur Erhebungskategorie: Bauwerke (Gebäude) nach dem DLM des BEV, die innerhalb der generalisierten ÖROK-Flächenwidmungskategorie 5 'Freizeit- und Erholung' bzw. innerhalb einer der DLM-Klassen, die zu diesem Modul gehören, liegen"@de,
            "no evaluation category, only survey category: Buildings (buildings) according to the DLM of the Bev that are within the generalized ÖROK area dedication category 5 'Leisure and recreation' or within one of the DLM classes that belong to this module"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "301" ;
