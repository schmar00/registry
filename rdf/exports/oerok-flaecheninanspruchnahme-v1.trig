@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/ns/adms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme:1> {
    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/101> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> ;
        skos:definition "Unter der Auswertungskategorie 'Autobahn und Schnellstraßen' werden alle Straßen und Begleitflächen erfasst, die durch die ASFINAG verwaltet und nicht land- oder forstwirtschaftlich genutzt werden,. Waldinseln bei Autobahnabfahrten sind ausgenommen, sofern sie im Waldlayer erfasst sind. Zu- und Abfahrten sowie Rast- bzw. Mautstätten sind Teil der Autobahn."@de,
            "The evaluation category 'Motorways and expressways' encompasses all roads and ancillary land managed by ASFINAG that are not used for agriculture or forestry. Wooded patches within motorway junctions are excluded if they are recorded in the forest layer. Access and exit ramps as well as service areas and toll plazas are considered part of the motorway."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "101" ;
        skos:prefLabel "Autobahn und Schnellstraße"@de,
            "Motorway and expressway"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/102> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> ;
        skos:definition "Diese Kategorie umfasst alle Straßen, die als Landesstraße von den Bundesländern verwaltet werden. Dies inkludiert die früheren Bundestraßen (Landesstraße B) sowie alle Landesstraßen (L)."@de,
            "This category comprises all roads administered as provincial roads by the federal provinces. This includes former federal highways (provincial road B) as well as all standard provincial roads (L)."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "102" ;
        skos:prefLabel "Landesstraße B und L"@de,
            "Provincial road B and L"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/103> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> ;
        skos:definition """Die Kategorie '103 – Gemeinde und sonstige Straßen' ist die wohl heterogenste Straßenkategorie. Sie enthält sowohl alle Gemeindestraßen als auch Straßen der inneren Siedlungserschließung, Zu- und Abfahrten, Radwege, und landwirtschaftliche Güterwege.
Aufgrund der Definition sind Forst- und Almstraßen nicht umfasst. Da es in der GIP keine einheitliche Klassifizierung von Forststraßen gibt, wurde die Identifizierung von Forststraßen durch bundesländerspezifische Abfragen sowie den Waldlayer des BFW vorgenommen. 
Im landwirtschaftlichen Bereich werden landwirtschaftliche Güterwege immer auch anhand der INVEKOS Schlagabgrenzungen korrigiert. Somit ist sichergestellt, dass keine Straße eine landwirtschaftliche Nutzfläche überlagert."""@de,
            """The category '103 – Municipal and other roads' is arguably the most heterogeneous road category. It encompasses all municipal roads as well as internal settlement access roads, access and exit ramps, cycle paths, and agricultural access roads (Güterwege).
By definition, forestry roads and alpine pasture roads are not included. Since there is no uniform classification of forestry roads in the GIP (Graph Integration Platform), forestry roads were identified using federal-state-specific queries as well as the forest layer of the BFW (Federal Research and Training Centre for Forests). 
In the agricultural sector, agricultural access roads are also systematically adjusted based on INVEKOS (IACS) agricultural parcel boundaries. This ensures that no road overlaps an utilized agricultural area."""@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "103" ;
        skos:prefLabel "Gemeinde- und sonstige Straßen"@de,
            "Municipal and other roads"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/104> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> ;
        skos:definition "In dieser Kategorie sind alle schienenbezogenen Anlagen der ÖBB sowie der Privatbahnen inklusive der zugehörigen Begleitflächen umfasst. Diese enthalten auch alle Gebäude (Bahnhofsgebäude) und Nebenflächen."@de,
            "This category encompasses all rail-related facilities of the ÖBB (Austrian Federal Railways) as well as private railways, including associated adjoining land. These also include all buildings (station buildings) and ancillary areas."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "104" ;
        skos:prefLabel "Schiene"@de,
            "Railway"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/105> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100> ;
        skos:definition "Die Auswertungskategorie '105 – Flughafen' enthält alle Flughäfen in Österreich, die im digitalen Landschaftsmodell des BEV eine Flughafenabgrenzung aufweisen. Inkludiert sind alle Gebäude und Bauwerke sowie die Lande-/Startbahnen, Zufahrtswege und Rollwege. Weiters alle Zwischenflächen, die dem Flughafenbetrieb dienen (u.a. auch alle Rasenflächen zwischen den Rollbahnen, sofern sie nicht landwirtschaftlich genutzt werden.)"@de,
            "The evaluation category '105 – Airport' includes all airports in Austria that have an airport boundary in the BEV Digital Landscape Model. This includes all buildings and structures, as well as runways, access roads, and taxiways. Furthermore, it encompasses all intermediate areas serving airport operations (including all grassy areas between taxiways, provided they are not used for agricultural purposes)."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "105" ;
        skos:prefLabel "Flughafen"@de,
            "Airport"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/2112> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/211> ;
        skos:definition "Die 'Wohnnutzung' umfasst alle Flächen, die in den Flächenwidmungsplänen entweder überwiegend als Wohnnutzung oder als gemischte Nutzung (Wohnen und Gewerbe) ausgewiesen sind. Sie enthält sowohl die klassische Einfamilienhaussiedlung wie auch den mehrgeschossigen Wohnbau oder innerstädtische gemischte Wohn- und Geschäftsviertel inklusive begrünter Innenhöfe und Gartenanlagen, sofern diese nicht als eigene Sport-, Freizeit oder Erholungsflächen gewidmet sind."@de,
            "'Residential use' encompasses all areas designated in zoning plans either predominantly for residential use or for mixed use (residential and commercial). It includes traditional single-family housing developments as well as multi-storey residential housing or inner-city mixed residential and commercial quarters, including green courtyards and garden areas, provided they are not designated as dedicated sports, leisure, or recreational areas."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "2112" ;
        skos:prefLabel "Wohn- und gemischte bauliche Nutzung"@de,
            "residential and mixed built-up use"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/212> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "Flächen in der ÖROK-aggregierten Widmungsklasse 2 'gemischte Nutzung' exklusive den Verkehrsflächen aus Modul 10."@de,
            "Areas in the ÖROK-aggregated zoning category 2 'mixed use' excluding transport areas from Module 10."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "212" ;
        skos:prefLabel "gemischte bauliche Nutzung"@de,
            "mixed building use"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/213> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "Die Industrie- und Gewerbeflächen beinhalten sämtliche Siedlungsflächen innerhalb der Baulandwidmung, die nicht landwirtschaftliche genutzt werden oder im Modul Verkehr liegen und die in den aggregierten Flächenwidmungsklassen als Klasse mit 'überwiegend betriebliche Nutzungsform' ausgewiesen sind. Darunter fallen Industrie, Gewerbe- und Geschäftswidmungen, so wie Einkaufzentren, Fachmarktzentren oder Handelseinrichtungen."@de,
            "Industrial and commercial areas comprise all settlement areas within building land zoning that are not used for agriculture or located within the transport module, and which are designated in the aggregated zoning categories as a class with 'predominantly commercial and industrial use'. This includes industrial, commercial, and business zoning designations, as well as shopping centres, retail parks, or retail facilities."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "213" ;
        skos:prefLabel "betriebliche Nutzung"@de,
            "commercial and industrial use"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/214> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "In der Klasse 'sonstige bauliche Nutzung' fallen sämtliche bauliche Widmungen, die nicht in einer der obigen Klassen oder der Widmung 'Freizeit- und Erholungsfläche' bzw. 'Ver-, Entsorgungs- und Abbauflächen' enthalten sind."@de,
            "The class 'other structural use' includes all structural zoning designations that are not included in any of the above classes or in the designations 'leisure and recreation area' or 'supply, disposal and extraction areas'."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "214" ;
        skos:prefLabel "sonstige bauliche Nutzung"@de,
            "other structural use"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/215> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "Landwirtschaftsflächen, die im INVEKOS registriert sind, und innerhalb der Baulandwidmung liegen."@de,
            "Agricultural areas that are registered in the IACS and are within the building land use."@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "215" ;
        skos:prefLabel "Landwirtschaft (INVEKOS) innerhalb BL-FläWi"@de,
            "Agriculture (IACS) within BL-FläWi"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/216> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "Waldflächen innerhalb der Baulandwidmung"@de,
            "Forest areas within the building land use"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "216" ;
        skos:prefLabel "Wald innerhalb BL-FläWi"@de,
            "Forest within BL-FläWi"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/217> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210> ;
        skos:definition "Landwirtschaftsflächen, die zwar nicht im INVEKOS registriert sind, aber aufgrund von Fernerkundungsauswertungen als aktive landwirtschaftliche Flächen identifiziert sind und innerhalb der Baulandwidmung liegen"@de,
            "Agricultural areas that are not registered in the IACS, but are identified as active agricultural areas on the basis of remote sensing evaluations and are within the building land use"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
        skos:notation "217" ;
        skos:prefLabel "LW (nicht INVEKOS) innerhalb BL-FläWi"@de,
            "LW (not IVEKOS) within BL-FläWi"@en ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/valid> .

    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/221> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220> ;
        skos:definition "keine Auswertungskategorie, nur Erhebungskategorie: Bauwerke (Gebäude) größer als 50m2 nach dem DLM des BEV, die in keinem anderen Modul enthalten sind"@de,
