    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/395> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/300> ;
        skos:definition "Landwirtschaftsflächen, die im INVEKOS registriert sind, und innerhalb der aggregierten ÖROK-Widmungskategorie 5 'Freizeit und Erholung' liegen"@de,
