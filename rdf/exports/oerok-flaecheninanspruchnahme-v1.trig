    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/225> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220> ;
        skos:definition "keine Auswertungskategorie, nur Erhebungskategorie: DKM-Nutzungsart 'Garten', wenn dieser Garten unmittelbar an ein Gebäude angrenzt und die gleiche Einlagezahl in der DKM aufweist"@de,
            "no evaluation category, only survey category: DKM type of use 'garden', if this garden directly adjoins a building and has the same number of deposits in the DKM"@en ;
        skos:inScheme <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme> ;
