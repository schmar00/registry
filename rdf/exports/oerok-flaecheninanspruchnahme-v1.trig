    <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/396> a skos:Concept ;
        skos:broader <https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/300> ;
        skos:definition "Waldflächen innerhalb der aggregierten ÖROK-Widmungskategorie 5 'Freizeit und Erholung' liegen"@de,
