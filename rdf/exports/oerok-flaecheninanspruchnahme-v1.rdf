  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/611">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/610"/>
    <skos:definition xml:lang="de">Landwirtschaftsflächen, die im INVEKOS registriert sind, und außerhalb des Verkehrs und der aggregierten ÖROK-Widmungsklassen 1-7 liegen</skos:definition>
    <skos:definition xml:lang="en">Agricultural land registered in the IACS and outside traffic and the aggregated ÖROK dedication classes 1-7</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>611</skos:notation>
    <skos:prefLabel xml:lang="en">LW-INVEKOS in the open area</skos:prefLabel>
    <skos:prefLabel xml:lang="de">LW-INVEKOS in der Freifläche</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/612">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/610"/>
    <skos:definition xml:lang="de">Landwirtschaftsflächen, die im nicht im INVEKOS registriert sind, und außerhalb des Verkehrs sowie außerhalb der aggregierten ÖROK-Widmungsklassen 1-7 liegen</skos:definition>
    <skos:definition xml:lang="en">Agricultural land that is not registered in the IACS and is out of traffic and outside the aggregated ÖROK dedication classes 1-7</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>612</skos:notation>
    <skos:prefLabel xml:lang="en">LW-outside IACS in the open area</skos:prefLabel>
    <skos:prefLabel xml:lang="de">LW-ausserhalb INVEKOS in der Freifläche</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/212">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210"/>
    <skos:definition xml:lang="de">Flächen in der ÖROK-aggregierten Widmungsklasse 2 'gemischte Nutzung' exklusive den Verkehrsflächen aus Modul 10.</skos:definition>
    <skos:definition xml:lang="en">Areas in the ÖROK-aggregated zoning category 2 'mixed use' excluding transport areas from Module 10.</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>212</skos:notation>
    <skos:prefLabel xml:lang="en">mixed building use</skos:prefLabel>
    <skos:prefLabel xml:lang="de">gemischte bauliche Nutzung</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">These settlement areas within the designated building land consist of developed, partially developed, and undeveloped parcels of land within the designated building land, provided that they are not actively used for agricultural purposes or forested. Land use is subdivided into three main categories based on the aggregated land-use designation categories (residential use, commercial use, other built-up uses). Transportation areas are accounted for in the transportation module. If transportation areas are recorded in the transportation module, they are uniformly excluded from the “Settlement Area” module. Internal access roads or larger parking areas for stationary traffic may still be recorded very differently in land-use designations depending on the federal state. Therefore, standardized recording as transportation areas is necessary within the framework of Austria-wide monitoring.</skos:definition>
    <skos:definition xml:lang="de">Diese 	Siedlungsflächen innerhalb des gewidmeten Baulandes bestehen aus bebauten, teilweise bebauten sowie unbebauten Grundstücken im gewidmeten Bauland, sofern diese nicht aktiv landwirtschaftlich genutzt oder bewaldet sind. Es erfolgt eine Untergliederung der Inanspruchnahme nach drei Hauptnutzungen anhand der aggregierten Flächenwidmungskategorien (Wohnnutzung, betriebliche Nutzung, sonstige bauliche Nutzungen).
Verkehrsflächen werden im Verkehrsmodul berücksichtigt, sofern Verkehrsflächen im Verkehrsmodul erfasst sind, werden sie einheitlich vom Modul 'Siedlungsfläche' ausgenommen. Die Verkehrswege der inneren Erschließung oder größere Parkflächen für den ruhenden Verkehr können je nach Bundesland noch sehr unterschiedlich in der Flächenwidmung erfasst sein. Daher ist eine standardisierte Erfassung als Verkehrsfläche im Rahmen des österreichweiten Monitorings erforderlich.</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/217"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/216"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/215"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/214"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/213"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/212"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/211"/>
    <skos:notation>210</skos:notation>
    <skos:prefLabel xml:lang="en">Siedlungsfläche innerhalb Baulandwidmung (Modul 21)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Siedlungsfläche innerhalb Baulandwidmung (Modul 21)</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/495">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400"/>
    <skos:definition xml:lang="de">Landwirtschaftsflächen, die im INVEKOS registriert sind, und innerhalb der aggregierten ÖROK-Widmungskategorie 6 und 7 'Ver- und Entsorgung' bzw. 'Abbauflächen' liegen</skos:definition>
    <skos:definition xml:lang="en">Agricultural areas registered in the IACS and within the aggregated ÖROK dedication category 6 and 7 'Supply and disposal' or 'Mining areas'</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>495</skos:notation>
    <skos:prefLabel xml:lang="de">Landwirtschaft (INVEKOS) innerhalb V und E, Abbauflächen</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Agriculture (IACS) within V and E, mining areas</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/224">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220"/>
    <skos:definition xml:lang="en">no evaluation category, only survey category: buffer area of 11m around buildings outside the zoning or outside the identified thematic areas of the DLM of the Bev</skos:definition>
    <skos:definition xml:lang="de">keine Auswertungskategorie, nur Erhebungskategorie: Pufferfläche von 11m rund um Gebäude außerhalb der Flächenwidmung bzw. außerhalb der identifizierten thematischen Flächen des DLMs des BEV</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>224</skos:notation>
    <skos:prefLabel xml:lang="de">Pufferfläche (11m) außerhalb Baulandwidmung</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Buffer area (11m) outside land use</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/223">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220"/>
    <skos:definition xml:lang="en">no evaluation category, only survey category: DKM utility type 'operating area', frozen with the DKM status 2022</skos:definition>
    <skos:definition xml:lang="de">keine Auswertungskategorie, nur Erhebungskategorie: DKM-Nutzugnsarte 'Betriebsfläche', eingefroren mit dem DKM-Stand 2022</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>223</skos:notation>
    <skos:prefLabel xml:lang="de">DKM-Betriebsfläche außerhalb Baulandwidmung</skos:prefLabel>
    <skos:prefLabel xml:lang="en">DKM operating area outside building land allocation</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/2112">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/211"/>
    <skos:definition xml:lang="de">Die 'Wohnnutzung' umfasst alle Flächen, die in den Flächenwidmungsplänen entweder überwiegend als Wohnnutzung oder als gemischte Nutzung (Wohnen und Gewerbe) ausgewiesen sind. Sie enthält sowohl die klassische Einfamilienhaussiedlung wie auch den mehrgeschossigen Wohnbau oder innerstädtische gemischte Wohn- und Geschäftsviertel inklusive begrünter Innenhöfe und Gartenanlagen, sofern diese nicht als eigene Sport-, Freizeit oder Erholungsflächen gewidmet sind.</skos:definition>
    <skos:definition xml:lang="en">'Residential use' encompasses all areas designated in zoning plans either predominantly for residential use or for mixed use (residential and commercial). It includes traditional single-family housing developments as well as multi-storey residential housing or inner-city mixed residential and commercial quarters, including green courtyards and garden areas, provided they are not designated as dedicated sports, leisure, or recreational areas.</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>2112</skos:notation>
    <skos:prefLabel xml:lang="de">Wohn- und gemischte bauliche Nutzung</skos:prefLabel>
    <skos:prefLabel xml:lang="en">residential and mixed built-up use</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/415">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/410"/>
    <skos:definition xml:lang="en">no evaluation category, only survey category: DKM operating areas that repaired power plants (run-of-river power plants and chaloric power plants)</skos:definition>
    <skos:definition xml:lang="de">keine Auswertungskategorie, nur Erhebungskategorie: DKM-Betriebsflächen, die Kraftwerke (Laufkraftwerke und chalorische Kraftwerke) repärsentieren</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>415</skos:notation>
    <skos:prefLabel xml:lang="en">DKM Operation/Power Plant (2022 only)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">DKM Betrieb/Kraftwerk (nur 2022)</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/643">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/640"/>
    <skos:definition xml:lang="en">Open spaces that, however, were still allocated to land use in the DKM in the old monitoring before 2022 (e.g.: buildings, gardens, etc.)</skos:definition>
    <skos:definition xml:lang="de">Freiflächen, die jedoch in der DKM im alten Monitoring vor 2022 noch der Flächeninanspruchnahme zugerechnet wurden (z.B.: Gebäude, Gärten, etc.)</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>643</skos:notation>
    <skos:prefLabel xml:lang="de">FI- sonstige alte FI-Flächen aus DKM in der Freifläche</skos:prefLabel>
    <skos:prefLabel xml:lang="en">FI- other old FI areas from DKM in the open area</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/311">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/300"/>
    <skos:definition xml:lang="en">no evaluation category, only survey category: Areas that lie within the aggregated ÖROK dedication category 5 'Leisure and recreation'</skos:definition>
    <skos:definition xml:lang="de">keine Auswertungskategorie, nur Erhebungskategorie: Flächen, die innerhalb der aggregierten ÖROK-Widmungskategorie 5 'Freizeit- und Erholung' liegen</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>311</skos:notation>
    <skos:prefLabel xml:lang="en">FläWi-Kat 5 Leisure/Recreation</skos:prefLabel>
    <skos:prefLabel xml:lang="de">FläWi-Kat 5 Freizeit/Erholung</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/102">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100"/>
    <skos:definition xml:lang="en">This category comprises all roads administered as provincial roads by the federal provinces. This includes former federal highways (provincial road B) as well as all standard provincial roads (L).</skos:definition>
    <skos:definition xml:lang="de">Diese Kategorie umfasst alle Straßen, die als Landesstraße von den Bundesländern verwaltet werden. Dies inkludiert die früheren Bundestraßen (Landesstraße B) sowie alle Landesstraßen (L).</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>102</skos:notation>
    <skos:prefLabel xml:lang="en">Provincial road B and L</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Landesstraße B und L</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/600">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Open spaces that do not count as land use</skos:definition>
    <skos:definition xml:lang="de">Freiflächen, die nicht zur Flächeninanspruchnahme zählen</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/640"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/630"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/620"/>
    <skos:narrower rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/610"/>
    <skos:notation>600</skos:notation>
    <skos:prefLabel xml:lang="en">Open spaces (module 60)</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Freiflächen (Modul 60)</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/497">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400"/>
    <skos:definition xml:lang="de">Landwirtschaftsflächen, die zwar nicht im INVEKOS registriert sind, aber aufgrund von Fernerkundungsauswertungen als aktive landwirtschaftliche Flächen identifiziert sind und ÖROK-Widmungskategorie 6 und 7 'Ver- und Entsorgung' bzw. 'Abbauflächen' liegen</skos:definition>
    <skos:definition xml:lang="en">Agricultural areas that are not registered in the IACS, but are identified as active agricultural areas based on remote sensing evaluations and ÖROK dedication categories 6 and 7 'Supply and disposal' or 'Mining areas'</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"/>
    <skos:notation>497</skos:notation>
    <skos:prefLabel xml:lang="en">LW (not IACS) within V-E, mining areas</skos:prefLabel>
    <skos:prefLabel xml:lang="de">LW (nicht INVEKOS) innerhalb V-E, Abbauflächen</skos:prefLabel>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/valid"/>
  </rdf:Description>
