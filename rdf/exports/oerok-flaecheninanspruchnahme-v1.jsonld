      },
      {
        "@language": "en",
        "@value": "Agricultural land that is not registered in the IACS and is out of traffic and outside the aggregated ÖROK dedication classes 1-7"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
