  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/217",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "de",
        "@value": "Landwirtschaftsflächen, die zwar nicht im INVEKOS registriert sind, aber aufgrund von Fernerkundungsauswertungen als aktive landwirtschaftliche Flächen identifiziert sind und innerhalb der Baulandwidmung liegen"
      },
      {
        "@language": "en",
        "@value": "Agricultural areas that are not registered in the IACS, but are identified as active agricultural areas on the basis of remote sensing evaluations and are within the building land use"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "217"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "LW (not IVEKOS) within BL-FläWi"
      },
      {
        "@language": "de",
        "@value": "LW (nicht INVEKOS) innerhalb BL-FläWi"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://inspire.ec.europa.eu/registry/status/valid"
      }
    ]
  },
  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "de",
        "@value": "Verkehrsflächen umfassen alle Straßen, befestigte befahrbare Wege (z.B. landwirtschaftliche Güterwege) mit Ausnahme der Forst- und Almstraßen, Schienen sowie die funktional zugehörigen Flächen für den ruhenden Verkehr (z.B. Parkplätze, Bahnanlagen)."
      },
      {
        "@language": "en",
        "@value": "Transport areas comprise all roads, paved drivable tracks (e.g. agricultural service roads) with the exception of forest and alpine roads, railways, as well as functionally associated areas for stationary traffic (e.g. parking facilities, railway installations)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/105"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/104"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/103"
