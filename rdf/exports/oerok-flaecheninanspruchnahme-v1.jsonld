      }
    ]
  },
  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/220",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The settlement areas outside the dedicated building land include buildings outside the building land use and their functionally associated areas (building contiguous areas, directly adjacent gardens, DKM operating areas, buffer areas), such as houses or scattered settlements in grassland, farms and other agricultural buildings with their ancillary areas.\nIn this class, all buildings are recorded that are neither in the traffic module nor in one of the aggregated zoning classes."
      },
      {
        "@language": "de",
        "@value": "Die Siedlungsflächen außerhalb des gewidmeten Baulandes umfassen Gebäude außerhalb der Baulandwidmung und ihre funktional zugehörigen Flächen (Gebäudenebenflächen, direkt angrenzende Gärten, DKM-Betriebsflächen, Pufferflächen), wie zum Beispiel Häuser oder Streusiedlungen im Grünland, Bauernhöfe und weitere landwirtschaftliche Gebäude mit ihren Nebenflächen.\nIn dieser Klasse werden alle Gebäude erfasst, die weder im Verkehrsmodul noch in einer der aggregierten Flächenwidmungsklassen liegen. Die funktional zugeordneten Gärten werden mittels der DKM-Nutzungsart 'Hausgärten' erfasst, die entweder am gleichen Grundstück liegen oder auf benachbarten Grundstücken mit der gleichen Einlagezahl. Auch Betriebsflächen oder Gebäudenebenflächen werden gleichermaßen zugeordnet. Sofern keine direkt angrenzenden funktionalen Flächen in der DKM vorhanden sind, werden alle Flächen bis zu 11m rund um die Gebäude als zugehörige Flächen mitberechnet."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/225"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/224"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/223"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/222"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/221"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "220"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "de",
        "@value": "Siedlungsfläche außerhalb Baulandwidmung (Modul 22)"
      },
      {
        "@language": "en",
        "@value": "Settlement area outside building land (module 22)"
      }
    ],
