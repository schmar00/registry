        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/410"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "no evaluation category, only survey category: DKM operating areas that repaired power plants (run-of-river power plants and chaloric power plants)"
      },
      {
        "@language": "de",
        "@value": "keine Auswertungskategorie, nur Erhebungskategorie: DKM-Betriebsflächen, die Kraftwerke (Laufkraftwerke und chalorische Kraftwerke) repärsentieren"
      }
    ],
