      {
        "@value": "415"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "DKM Operation/Power Plant (2022 only)"
      },
      {
        "@language": "de",
        "@value": "DKM Betrieb/Kraftwerk (nur 2022)"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://inspire.ec.europa.eu/registry/status/valid"
      }
    ]
  },
  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/420",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/400"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "'Mining areas', 'dumps' and 'landfills' are areas used for the above-ground extraction of raw materials (e.g. sand pit, clay pit, gravel pit, quarry, peat cut) or for the permanent deposition of waste materials (definition: Bev types of use).\nIn ÖROK monitoring, these areas are formed on the one hand by the area utilization of the digital landscape model (category 3411 mining processing areas) and by category 7 'mining areas' of the aggregated land use."
      },
      {
        "@language": "de",
        "@value": "'Abbauflächen', 'Halden' und 'Deponien' sind Flächen, die zur oberirdischen Gewinnung von Rohstoffen (z.B. Sandgrube, Lehmgrube, Schottergrube, Steinbruch, Torfstich) oder zur dauerhaften Ablagerung von Altstoffen dienen (Definition: BEV Nutzungsarten).\nIm ÖROK-Monitoring werden diese Flächen einerseits durch die Gebietsnutzung des digitalen Landschaftsmodells (Kategorie 3411 Abbau-Aufbereitugnsflächen) sowie durch die Kategorie 7 'Abbauflächen' der aggregierten Flächenwidmung gebildet."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/425"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/424"
      },
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/422"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "420"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Mining area (module 42)"
      },
      {
        "@language": "de",
        "@value": "Abbaufläche (Modul 42)"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://inspire.ec.europa.eu/registry/status/valid"
      }
    ]
  },
