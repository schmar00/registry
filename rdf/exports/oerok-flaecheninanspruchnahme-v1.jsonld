  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/213",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/210"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Industrial and commercial areas comprise all settlement areas within building land zoning that are not used for agriculture or located within the transport module, and which are designated in the aggregated zoning categories as a class with 'predominantly commercial and industrial use'. This includes industrial, commercial, and business zoning designations, as well as shopping centres, retail parks, or retail facilities."
      },
      {
        "@language": "de",
        "@value": "Die Industrie- und Gewerbeflächen beinhalten sämtliche Siedlungsflächen innerhalb der Baulandwidmung, die nicht landwirtschaftliche genutzt werden oder im Modul Verkehr liegen und die in den aggregierten Flächenwidmungsklassen als Klasse mit 'überwiegend betriebliche Nutzungsform' ausgewiesen sind. Darunter fallen Industrie, Gewerbe- und Geschäftswidmungen, so wie Einkaufzentren, Fachmarktzentren oder Handelseinrichtungen."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "213"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "commercial and industrial use"
      },
      {
        "@language": "de",
        "@value": "betriebliche Nutzung"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://inspire.ec.europa.eu/registry/status/valid"
      }
    ]
  },
  {
