        "@language": "de",
        "@value": "DKM-Betriebsfläche außerhalb Baulandwidmung"
      },
      {
        "@language": "en",
        "@value": "DKM operating area outside building land allocation"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
