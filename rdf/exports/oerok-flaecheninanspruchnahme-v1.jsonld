  {
    "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/105",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme/100"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The evaluation category '105 – Airport' includes all airports in Austria that have an airport boundary in the BEV Digital Landscape Model. This includes all buildings and structures, as well as runways, access roads, and taxiways. Furthermore, it encompasses all intermediate areas serving airport operations (including all grassy areas between taxiways, provided they are not used for agricultural purposes)."
      },
      {
        "@language": "de",
        "@value": "Die Auswertungskategorie '105 – Flughafen' enthält alle Flughäfen in Österreich, die im digitalen Landschaftsmodell des BEV eine Flughafenabgrenzung aufweisen. Inkludiert sind alle Gebäude und Bauwerke sowie die Lande-/Startbahnen, Zufahrtswege und Rollwege. Weiters alle Zwischenflächen, die dem Flughafenbetrieb dienen (u.a. auch alle Rasenflächen zwischen den Rollbahnen, sofern sie nicht landwirtschaftlich genutzt werden.)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://registry.inspire.gv.at/codelist/oerok-flaecheninanspruchnahme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "105"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "de",
        "@value": "Flughafen"
      },
      {
        "@language": "en",
        "@value": "Airport"
      }
    ],
    "http://www.w3.org/ns/adms#status": [
      {
        "@id": "http://inspire.ec.europa.eu/registry/status/valid"
      }
    ]
  },
