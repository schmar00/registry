      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "no evaluation category, only survey category: DKM utility type 'operating area', frozen with the DKM status 2022"
      },
      {
        "@language": "de",
        "@value": "keine Auswertungskategorie, nur Erhebungskategorie: DKM-Nutzugnsarte 'Betriebsfläche', eingefroren mit dem DKM-Stand 2022"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
