  {
    "@id": "https://registry.inspire.gv.at/dataprovider/0015",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
