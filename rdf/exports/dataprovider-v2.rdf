  <rdf:Description rdf:about="https://registry.inspire.gv.at/dataprovider/0038">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-10-16T19:40:05.735000+00:00</dcterms:created>
    <ns2:successor rdf:resource="https://registry.inspire.gv.at/dataprovider/0134"/>
    <skos:definition xml:lang="de">Die 1851 gegründete Zentralanstalt für Meteorologie und Geodynamik (19., Hohe Warte 38-40; auch ZAMG oder Hohe Warte) war der staatliche meteorologische und geophysikalische Dienst der Monarchie später der Republik Österreich. Mit 1. Jänner 2023 fusioniert die Zentralanstalt für Meteorologie und Geodynamik mit der Geologischen Bundesanstalt zur neuen Bundesanstalt GeoSphere Austria. (aus Wien Geschichte Wiki)</skos:definition>
    <skos:inScheme rdf:resource="https://registry.inspire.gv.at/dataprovider"/>
    <skos:notation>0038</skos:notation>
    <skos:prefLabel xml:lang="de">Zentralanstalt für Meteorologie und Geodynamik (ZAMG)</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://registry.inspire.gv.at/dataprovider"/>
    <ns1:status rdf:resource="http://inspire.ec.europa.eu/registry/status/retired"/>
  </rdf:Description>
