    <https://registry.inspire.gv.at/dataprovider/0015> a skos:Concept ;
        dcterms:created "2025-10-16T19:40:05.735000+00:00"^^xsd:dateTime ;
        ns2:successor <https://registry.inspire.gv.at/dataprovider/0134> ;
        skos:definition "Die 1849 gegründete Geologische Bundesanstalt war eine dem Bundesministerium für Bildung, Wissenschaft und Forschung (BMBWF) nachgeordnete Dienststelle, die der Bundesrepublik und deren staatlichen Aufgaben als zentrale Informations- und Beratungsstelle im Fachbereich der Geowissenschaften diente. Mit 1. Jänner 2023 fusionierte die Geologische Bundesanstalt mit der Zentralanstalt für Meteorologie und Geodynamik (ZAMG) zur neuen Bundesanstalt GeoSphere Austria. (aus Wien Geschichte Wiki)"@de ;
        skos:inScheme <https://registry.inspire.gv.at/dataprovider> ;
        skos:notation "0015" ;
        skos:prefLabel "Geologische Bundesanstalt (GBA)"@de ;
        skos:topConceptOf <https://registry.inspire.gv.at/dataprovider> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/retired> .

    <https://registry.inspire.gv.at/dataprovider/0038> a skos:Concept ;
        dcterms:created "2025-10-16T19:40:05.735000+00:00"^^xsd:dateTime ;
        ns2:successor <https://registry.inspire.gv.at/dataprovider/0134> ;
        skos:definition "Die 1851 gegründete Zentralanstalt für Meteorologie und Geodynamik (19., Hohe Warte 38-40; auch ZAMG oder Hohe Warte) war der staatliche meteorologische und geophysikalische Dienst der Monarchie später der Republik Österreich. Mit 1. Jänner 2023 fusioniert die Zentralanstalt für Meteorologie und Geodynamik mit der Geologischen Bundesanstalt zur neuen Bundesanstalt GeoSphere Austria. (aus Wien Geschichte Wiki)"@de ;
        skos:inScheme <https://registry.inspire.gv.at/dataprovider> ;
        skos:notation "0038" ;
        skos:prefLabel "Zentralanstalt für Meteorologie und Geodynamik (ZAMG)"@de ;
        skos:topConceptOf <https://registry.inspire.gv.at/dataprovider> ;
        ns1:status <http://inspire.ec.europa.eu/registry/status/retired> .

